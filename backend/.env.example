# Copy to .env on the VM and fill in. Never commit the real file.

DATABASE_URL=postgresql://cerebro:CHANGEME@localhost/cerebro

# Categorizer: ollama (default, local on the VM) or anthropic (hosted fallback).
LLM_PROVIDER=ollama
LLM_MODEL=gemma3:4b
OLLAMA_URL=http://localhost:11434
# Keeps the model resident between syncs; without it the first call after a
# pause pays 10-20s of model load.
OLLAMA_KEEP_ALIVE=30m

# 0.6, not 0.7 — gemma3:4b's confidence is compressed and 0.7 also cuts
# correct categorisations.
CONFIDENCE_THRESHOLD=0.6
LLM_TIMEOUT_SECONDS=60

# Only when LLM_PROVIDER=anthropic:
# LLM_MODEL=claude-haiku-4-5
# ANTHROPIC_API_KEY=sk-ant-...
