   "isDeleted": false,
   "boundElements": null,
   "updated": 1786000000000,
   "link": null,
   "locked": false,
   "text": "Idei care nu au faza\n     · teme per user, sincronizate (acum sunt strict locale)\n     · HTTPS real prin `tailscale serve`, ca sa dispara\n       exceptia ATS din app.json\n     · haptics la ridicarea cardului in drag & drop",
   "originalText": "Idei care nu au faza\n     · teme per user, sincronizate (acum sunt strict locale)\n     · HTTPS real prin `tailscale serve`, ca sa dispara\n       exceptia ATS din app.json\n     · haptics la ridicarea cardului in drag & drop",
   "fontSize": 16,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
