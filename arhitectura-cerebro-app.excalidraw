   "boundElements": null,
   "updated": 1786000000000,
   "link": null,
   "locked": false,
   "text": "users(\n  id            SERIAL PRIMARY KEY,\n  name          TEXT NOT NULL UNIQUE,\n  api_key_hash  TEXT NOT NULL UNIQUE,   -- sha256; cheia in clar\n  created_at    TIMESTAMPTZ             -- se arata O SINGURA data\n)\n\ncategories(\n  id, user_id -> users(id),\n  name TEXT, icon TEXT, sort_order INT,\n  is_inbox BOOLEAN,          -- exact unul per user (index unic),\n  UNIQUE (user_id, name)     -- si nu se poate sterge\n)\n\nnotes(\n  uuid       UUID PRIMARY KEY,   -- generat pe TELEFON\n  user_id    -> users(id),\n  text       TEXT,\n  category_id -> categories(id)  NOT NULL,  -- de aici Inbox\n  confidence REAL,               -- NULL daca n-a trecut prin LLM\n  done       BOOLEAN,\n  deleted_at TIMESTAMPTZ,        -- soft delete / trash\n  created_at TIMESTAMPTZ,        -- ceasul telefonului\n  updated_at TIMESTAMPTZ,        -- baza pentru last-write-wins\n  server_received_at TIMESTAMPTZ\n)",
   "originalText": "users(\n  id            SERIAL PRIMARY KEY,\n  name          TEXT NOT NULL UNIQUE,\n  api_key_hash  TEXT NOT NULL UNIQUE,   -- sha256; cheia in clar\n  created_at    TIMESTAMPTZ             -- se arata O SINGURA data\n)\n\ncategories(\n  id, user_id -> users(id),\n  name TEXT, icon TEXT, sort_order INT,\n  is_inbox BOOLEAN,          -- exact unul per user (index unic),\n  UNIQUE (user_id, name)     -- si nu se poate sterge\n)\n\nnotes(\n  uuid       UUID PRIMARY KEY,   -- generat pe TELEFON\n  user_id    -> users(id),\n  text       TEXT,\n  category_id -> categories(id)  NOT NULL,  -- de aici Inbox\n  confidence REAL,               -- NULL daca n-a trecut prin LLM\n  done       BOOLEAN,\n  deleted_at TIMESTAMPTZ,        -- soft delete / trash\n  created_at TIMESTAMPTZ,        -- ceasul telefonului\n  updated_at TIMESTAMPTZ,        -- baza pentru last-write-wins\n  server_received_at TIMESTAMPTZ\n)",
   "fontSize": 15,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
