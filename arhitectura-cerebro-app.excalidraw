   "link": null,
   "locked": false,
   "text": "Fisiere .sql numerotate, rulate de db/migrate.sh, care tine evidenta\nin tabela schema_migrations. Fara Alembic, fara ORM.\n\n001_init.sql                 schema de baza\n002_one_inbox_per_user.sql   index unic partial pe is_inbox\n003_rename_idei_yt.sql       \"Idei YT\" -> \"Idei YouTube\", fiindca\n                             gemma nu lega \"YT\" de YouTube",
   "originalText": "Fisiere .sql numerotate, rulate de db/migrate.sh, care tine evidenta\nin tabela schema_migrations. Fara Alembic, fara ORM.\n\n001_init.sql                 schema de baza\n002_one_inbox_per_user.sql   index unic partial pe is_inbox\n003_rename_idei_yt.sql       \"Idei YT\" -> \"Idei YouTube\", fiindca\n                             gemma nu lega \"YT\" de YouTube",
   "fontSize": 15,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
