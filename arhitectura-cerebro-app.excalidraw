  {
   "id": "v3-text-0077",
   "type": "text",
   "x": 0.0,
   "y": 2230.0,
   "width": 789.36,
   "height": 27.5,
   "angle": 0,
   "strokeColor": "#6741d9",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
