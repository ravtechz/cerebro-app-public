   "text": "{\n  notes: [{\n    uuid, text, category_id, done, deleted_at,\n    created_at, updated_at,\n    needs_categorization      <- category_id === null\n  }],\n  new_categories:     [{ local_ref, name, icon }],\n  deleted_categories: [ id ]\n}",
   "originalText": "{\n  notes: [{\n    uuid, text, category_id, done, deleted_at,\n    created_at, updated_at,\n    needs_categorization      <- category_id === null\n  }],\n  new_categories:     [{ local_ref, name, icon }],\n  deleted_categories: [ id ]\n}",
